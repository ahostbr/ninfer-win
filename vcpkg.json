{
  "name": "ninfer",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "zlib"
      ]
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl",
        "non-http"
      ]
    }
  ],
  "builtin-baseline": "e0a6b8572cf0ac716fdc11466522cf744e97e0bd"
}
